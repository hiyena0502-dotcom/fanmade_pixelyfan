{
  "buildCommand": "npm run build",
  "functions": {
    "api/*.js": {
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        }
      ]
    },
    {
      "source": "/(index.html|game.html|chapters.html|collection.html|wardrobe.html|app.js|book-admin.js|book-editor.js|books.js|game.js|game-editor.js|viewport-preview.js|slot-menus.css|game.css|stage.css)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        }
      ]
    }
  ],
  "outputDirectory": "public",
  "regions": [
    "icn1"
  ]
}
